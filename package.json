{
  "name": "phodar",
  "version": "0.9.0",
  "description": "PHOtogrammetric Detection And Ranging — turn sighting photos into triangulated position, size, altitude & speed.",
  "type": "module",
  "license": "MIT",
  "author": "Court Christianson and Phodar contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/cchristianson/phodar.git"
  },
  "bugs": {
    "url": "https://github.com/cchristianson/phodar/issues"
  },
  "homepage": "https://github.com/cchristianson/phodar#readme",
  "keywords": [
    "ufo",
    "uap",
    "photogrammetry",
    "triangulation",
    "exif",
    "astronomy",
    "adsb",
    "react"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "start:static": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "skycheck": "node scripts/skycheck.mjs",
    "capcheck": "node scripts/capcheck.mjs",
    "storecheck": "node scripts/storecheck.mjs",
    "test": "node scripts/mathcheck.js && node scripts/trajcheck.js && echo ALL-MATH-CHECKS-PASS",
    "helpcheck": "node scripts/helpcheck.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satellite.js": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
